# LLM backend endpoint (ollama). Copy this file to .env and edit.
# Local run:   http://localhost:11434
# GPU cluster: http://<cluster-host>:11434
LLM_API_BASE=http://localhost:11434

# Optional API key. Only needed if the endpoint requires one.
# To activate: add `api_key_env: LLM_API_KEY` to the model(s) in the yaml config.
# LLM_API_KEY=
